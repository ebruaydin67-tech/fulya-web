# --- Server ---
PORT=3000
SESSION_SECRET=hier-ein-langes-zufaelliges-secret-einsetzen
ADMIN_PASSWORD=hier-ein-starkes-passwort-einsetzen

# --- E-Mail: Microsoft Graph (Shared Mailbox) ---
# Azure App-Registrierung mit Anwendungsberechtigung "Mail.Send"
# (Admin-Zustimmung erforderlich). Kein SMTP - Microsoft hat die
# Basisauthentifizierung fuer Exchange Online abgeschaltet.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SENDER_EMAIL=fulya@human-culture.com

# Optional: interne Kopie bei jeder neuen Anmeldung (Komma-getrennt moeglich)
# MAIL_NOTIFY_TO=info@human-culture.com

# Optional: abweichende Antwortadresse (Standard: AZURE_SENDER_EMAIL)
# MAIL_REPLY_TO=fulya@human-culture.com
